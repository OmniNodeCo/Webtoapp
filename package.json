{
  "name": "webtoapp",
  "version": "0.1.0",
  "description": "Wrap any trusted website in a focused desktop app.",
  "license": "MIT",
  "author": {
    "name": "OmniNodeCo"
  },
  "homepage": "https://github.com/OmniNodeCo/Webtoapp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniNodeCo/Webtoapp.git"
  },
  "bugs": {
    "url": "https://github.com/OmniNodeCo/Webtoapp/issues"
  },
  "keywords": [
    "desktop",
    "electron",
    "webapp",
    "wrapper",
    "website"
  ],
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.2.0"
  },
  "packageManager": "pnpm@10.26.2",
  "main": "lib/main.js",
  "bin": {
    "webtoapp": "lib/cli.js"
  },
  "files": [
    "app/lib",
    "app/package.json",
    "app/npm-shrinkwrap.json",
    "app/webtoapp.json",
    "icon-scripts",
    "lib",
    "shared/lib",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "DOCS.md",
    "HELP.md"
  ],
  "scripts": {
    "build-app": "cd app && webpack",
    "build-app-static": "ncp app/src/static/ app/lib/static/ && ncp app/dist/preload.js app/lib/preload.js && ncp app/dist/preload.js.map app/lib/preload.js.map",
    "build": "corepack pnpm run clean && tsc --build shared src app && corepack pnpm run build-app && corepack pnpm run build-app-static",
    "build:watch": "corepack pnpm run clean && tsc --build shared src app --watch",
    "clean": "rimraf coverage/ lib/ app/lib/ app/dist/ shared/lib",
    "clean:full": "corepack pnpm run clean && rimraf app/node_modules/ node_modules/ pnpm-lock.yaml",
    "lint:fix": "cd src && eslint . --ext .ts --fix && cd ../shared && eslint src --ext .ts --fix && cd ../app && eslint src --ext .ts --fix",
    "lint:format": "prettier --tab-width 4 --write 'src/**/*.ts' 'app/src/**/*.ts' 'shared/src/**/*.ts' '**/*.md",
    "lint": "eslint shared app src --ext .ts",
    "test:unit": "corepack pnpm run build && jest --runInBand --testPathIgnorePatterns=integration-test",
    "test": "corepack pnpm run test:unit",
    "test:watch": "corepack pnpm run build:watch & jest --watchAll --collectCoverage=false",
    "prepare": "corepack pnpm run build"
  },
  "dependencies": {
    "@electron/get": "^2.0.3",
    "@electron/packager": "^18.3.0",
    "axios": "^1.9.0",
    "electron-context-menu": "^4.0.1",
    "electron-dl": "^4.0.0",
    "electron-window-state": "^5.0.3",
    "fs-extra": "^11.3.0",
    "gitcloud": "^0.2.4",
    "glob": "^11.0.2",
    "hasbin": "^1.2.3",
    "loglevel": "^1.9.2",
    "ncp": "^2.0.0",
    "npm": "^11.4.0",
    "page-icon": "^0.4.0",
    "sanitize-filename": "^1.6.3",
    "source-map-support": "^0.5.21",
    "tmp": "^0.2.3",
    "yargs": "^17.7.2",
    "@electron/asar": "^3.4.1",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/hasbin": "^1.0.4",
    "@types/jest": "^29.5.14",
    "@types/ncp": "^2.0.8",
    "@types/node": "^22.15.3",
    "@types/page-icon": "^0.3.6",
    "@types/tmp": "^0.2.6",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "electron": "37.2.6",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "glob": "^11.0.2",
    "jest": "^29.7.0",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "jest": {
    "collectCoverage": false,
    "moduleNameMapper": {
      "^electron$": "<rootDir>/app/dist/mocks/electron.js"
    },
    "setupFiles": [
      "./lib/jestSetupFiles"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/app/node_modules.*",
      "<rootDir>/app/src.*",
      "<rootDir>/app/lib.*",
      "<rootDir>/src.*",
      ".+\\.d\\.ts",
      ".+\\.js\\.map"
    ],
    "testRegex": "test\\.js$"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4
  }
}
