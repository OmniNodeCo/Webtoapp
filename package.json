{
  "name": "webtoapp",
  "version": "0.1.0",
  "description": "Turn any trusted website into a lightweight desktop app for Windows, macOS, and Linux.",
  "homepage": "https://github.com/OmniNodeCo/Webtoapp",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.26.2",
  "bin": {
    "webtoapp": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmniNodeCo/Webtoapp.git"
  },
  "author": {
    "name": "OmniNodeCo"
  },
  "keywords": [
    "webtoapp",
    "website-to-app",
    "tauri",
    "desktop-app",
    "webview",
    "windows",
    "macos",
    "linux"
  ],
  "files": [
    "LICENSE",
    "LICENSE-EXCEPTION",
    "NOTICE.md",
    "dist/cli.js",
    "cli",
    "src-tauri",
    "schema"
  ],
  "scripts": {
    "cli:build": "cross-env NODE_ENV=production rollup -c",
    "cli:watch": "cross-env NODE_ENV=development rollup -c -w",
    "build": "corepack pnpm run cli:build && corepack pnpm run tauri build",
    "build:debug": "corepack pnpm run cli:build && corepack pnpm run tauri build --debug",
    "tauri": "tauri",
    "test": "corepack pnpm run test:unit",
    "test:unit": "vitest run",
    "format:check": "prettier --check . --ignore-unknown",
    "release:check": "corepack pnpm run format:check && corepack pnpm run test",
    "prepublishOnly": "corepack pnpm run cli:build"
  },
  "type": "module",
  "exports": "./dist/cli.js",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "file-type": "^21.3.4",
    "fs-extra": "^11.3.3",
    "loglevel": "^1.9.2",
    "ora": "^9.3.0",
    "prompts": "^2.4.2",
    "psl": "^1.15.0",
    "sharp": "^0.35.0",
    "tmp-promise": "^3.0.3",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.2",
    "@types/prompts": "^2.4.9",
    "@types/tmp": "^0.2.6",
    "@types/update-notifier": "^6.0.8",
    "app-root-path": "^3.1.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.0",
      "@img/sharp-libvips-darwin-arm64": "1.3.0",
      "tmp": "0.2.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "bugs": {
    "url": "https://github.com/OmniNodeCo/Webtoapp/issues"
  }
}
